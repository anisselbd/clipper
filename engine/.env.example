# --- LLM (selection des moments forts) ---
# Endpoint compatible OpenAI. Defaut : llama-server (llama.cpp) local.
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3
# Optionnelle (laisser vide pour un serveur local sans auth).
LLM_API_KEY=
# Fournisseur : local_llm (defaut) ou anthropic (stub phase 2).
LLM_PROVIDER=local_llm
LLM_TIMEOUT=180
# Desactive le mode "thinking" (Qwen3) pour une selection JSON directe et rapide.
LLM_DISABLE_THINKING=1
# Reessais par fenetre si la reponse LLM n'est pas un JSON exploitable.
LLM_RETRIES=2

# --- Transcription (faster-whisper) ---
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LANG_CODE=fr

# --- Selection ---
AUDIO_HIGHLIGHTS=1
CLIPS=8
MIN_DURATION=20
MAX_DURATION=60

# --- Recadrage ---
# Strategie : auto (decision par scene), face, motion (sport/action), center.
REFRAME_MODE=auto
PER_SCENE_REFRAME=1
SCENE_THRESHOLD=27
FACE_CONFIDENCE=0.5
SAMPLES_PER_SCENE=5

# --- Rendu ---
FPS=30
VIDEO_ENCODER=h264_videotoolbox
VIDEO_BITRATE=8M

# --- Sous-titres ---
# Police (chemin TTF/TTC). Vide = Arial Bold systeme par defaut.
FONT_PATH=
CAPTION_FONT_SIZE=76

# --- Chemins ---
OUTPUT_DIR=output
CACHE_DIR=cache
